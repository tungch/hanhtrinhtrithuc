{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "40rem",
			"wideSize": "64rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "Nen trang"
				},
				{
					"slug": "base-2",
					"color": "#F6F7F9",
					"name": "Nen phu"
				},
				{
					"slug": "contrast",
					"color": "#16181D",
					"name": "Chu chinh"
				},
				{
					"slug": "contrast-2",
					"color": "#3C414B",
					"name": "Chu phu"
				},
				{
					"slug": "contrast-3",
					"color": "#5F646E",
					"name": "Chu mo"
				},
				{
					"slug": "rule",
					"color": "#E4E6EA",
					"name": "Duong ke"
				},
				{
					"slug": "abooks",
					"color": "#51030E",
					"name": "Abooks"
				},
				{
					"slug": "abooks-wash",
					"color": "#FDECEF",
					"name": "Abooks nhat"
				},
				{
					"slug": "bbooks",
					"color": "#2A62BA",
					"name": "Bbooks"
				},
				{
					"slug": "bbooks-wash",
					"color": "#EEF3FB",
					"name": "Bbooks nhat"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, \"Segoe UI Variable\", \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"
							]
						}
					]
				},
				{
					"name": "Fira Sans",
					"slug": "fira-sans",
					"fontFamily": "\"Fira Sans\", \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/FiraSans-Regular.woff2" ]
						},
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/FiraSans-Italic.woff2" ]
						},
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/FiraSans-Medium.woff2" ]
						},
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/FiraSans-SemiBold.woff2" ]
						},
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/FiraSans-Bold.woff2" ]
						},
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "italic",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fira-sans/FiraSans-BoldItalic.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Nho",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Thuong",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "large",
					"name": "Lon",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.3125rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Rat lon",
					"size": "1.75rem",
					"fluid": {
						"min": "1.4375rem",
						"max": "1.875rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Tieu de trang",
					"size": "2.5rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.75rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "1rem" },
				{ "slug": "30", "name": "3", "size": "1.5rem" },
				{ "slug": "40", "name": "4", "size": "2.5rem" },
				{ "slug": "50", "name": "5", "size": "4rem" },
				{ "slug": "60", "name": "6", "size": "6rem" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--fira-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var(--wp--preset--spacing--20)",
				"right": "var(--wp--preset--spacing--20)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "800",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.12"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--bbooks)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--abooks)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"border": {
					"radius": "6px"
				},
				"spacing": {
					"padding": {
						"top": "0.7rem",
						"bottom": "0.7rem",
						"left": "1.2rem",
						"right": "1.2rem"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--contrast-3)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "800",
					"letterSpacing": "-0.02em"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--contrast-3)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.07em"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "800",
					"letterSpacing": "-0.015em",
					"textDecoration": "none"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--rule)"
				}
			}
		}
	}
}
